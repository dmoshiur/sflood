# App mode: leave DATABASE_URL blank to use the local simulation JSON store.
API_PORT=3000
HOST=0.0.0.0
# Set only when behind a trusted reverse proxy; do not blindly trust client-supplied forwarding headers.
TRUST_PROXY=
DEMO_DATA_FILE=
DEMO_DEVICE_API_KEY=replace-with-a-random-local-preview-token
DEMO_SENDER_API_KEY=replace-with-a-separate-random-local-preview-token

# PostgreSQL production-like mode (run npm run db:generate, db:push, db:seed).
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/floodguard?schema=public
FG_ESP32_API_KEY=replace-with-a-unique-random-key-at-least-32-chars
FG_ESP8266_API_KEY=replace-with-a-different-random-key-at-least-32-chars
# Comma-separated real sensor gateway CIDRs. Empty means device ingest is denied in Postgres mode.
DEVICE_CIDR_ALLOWLIST=203.0.113.0/24
# Reserved for the future protected OWNER/admin console; no admin-write API is exposed now.
ADMIN_CIDR_ALLOWLIST=203.0.113.0/24
OWNER_BOOTSTRAP_TOKEN=
SESSION_SECRET=

# Optional, not required for the local demo.
PUBLIC_APP_URL=https://your-public-host.example
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:project-owner@example.org
RESEND_API_KEY=
RESEND_FROM=FloodGuard <no-reply@example.org>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
CLOUDINARY_URL=
