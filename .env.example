# FloodGrid environment template.
# Copy to .env and fill in. .env is git-ignored and must never be committed.
# Every value below is read server-side only; nothing here reaches the browser.

# ---------------------------------------------------------------- app ----
NODE_ENV=development
# Binds inside the container/Render instance. Render sets PORT itself; API_PORT
# is only needed when you run the API beside another service.
API_PORT=3000
HOST=0.0.0.0
# Set to the number of proxy hops in front of the app (Render: 1). 0 = direct.
TRUST_PROXY=1
APP_VERSION=1.0.0
# Optional commit marker written into the deployment_info table.
GIT_COMMIT=
# Canonical public HTTPS origin, no trailing slash. Used for email verification,
# unsubscribe links, password resets and push notification links.
PUBLIC_APP_URL=https://floodgrid.example.org

# ------------------------------------------------------------ database ----
# Leave TURSO_DATABASE_URL empty to run on the local libSQL file in data/.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Override the local database path (defaults to data/floodgrid.db).
LIBSQL_FILE=

# ------------------------------------------------------------- secrets ----
# Generate independent high-entropy values and keep them in a secret manager.
# SESSION_SECRET: at least 32 random characters. Keys sessions and one-time
# email/unsubscribe tokens.
SESSION_SECRET=
# SETTINGS_ENCRYPTION_KEY: 32 random bytes as 64 hex chars (or base64url).
# Encrypts SMTP/SMS provider credentials and TOTP secrets with AES-256-GCM.
# Back it up: losing it makes stored provider settings unreadable.
SETTINGS_ENCRYPTION_KEY=
# OWNER_BOOTSTRAP_TOKEN: at least 32 random characters. One-time, out-of-band
# credential used only to create the first super-admin (OWNER) account.
OWNER_BOOTSTRAP_TOKEN=
# Set to false to close public self-registration (invitations still work).
PUBLIC_REGISTRATION_OPEN=true

# --------------------------------------------------------- access lists ---
# Comma-separated CIDRs. Privileged admin/ops actions fail closed when these
# are empty in production.
ADMIN_CIDR_ALLOWLIST=
OPS_CIDR_ALLOWLIST=
# Source ranges allowed to POST device telemetry. Required in production.
DEVICE_CIDR_ALLOWLIST=

# ------------------------------------------------------------ sessions ----
SESSION_TTL_HOURS=12
ADMIN_SESSION_TTL_HOURS=4
OPS_SESSION_TTL_MINUTES=30
PASSWORD_MIN_LENGTH=10

# ------------------------------------------- rotating ops credential ------
# /hackeradmin authenticates with a credential that is emailed, stored only as
# a SHA-256 hash, single-use, rate-limited and short lived. The value is never
# exposed in URLs, browser source, frontend JS, logs or errors.
OPS_SECURITY_EMAIL=security@example.org
OPS_ROTATION_MINUTES=60
OPS_CREDENTIAL_TTL_MINUTES=75
OPS_MAX_ATTEMPTS=5
# Second factor for the ops console: TOTP. Set to false only for local trials.
OPS_REQUIRE_MFA=true

# ------------------------------------------------------------- Web Push ---
# Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:project-owner@example.org

# ------------------------------------------------------------ Cloudinary --
# Used for signed avatar uploads. The cloud name is public; the API secret
# never leaves the server. SMTP/SMS credentials are NOT set here: they are
# entered in the admin console and encrypted at rest.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_FOLDER=floodgrid/avatars

# ------------------------------------------------------ firmware links ----
# Download links shown in the app and the device console. Empty means the link
# is hidden; no repository URL is hard-coded anywhere in the product.
FIRMWARE_GITHUB_ESP32_URL=
FIRMWARE_GITHUB_ESP8266_URL=
FIRMWARE_GITHUB_RELEASES_URL=

# ------------------------------------------------- optional integrations --
# Secondary, advisory IP geolocation used only as a hint during registration.
# Eligibility is decided by the service-area allowlist, never by IP alone.
IP_GEO_LOOKUP_URL=
IP_GEO_LOOKUP_TOKEN=
# Optional MQTT bridge for an external broker.
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=floodgrid
