# App binds inside the container/sandbox; only trust a proxy you control.
API_PORT=3000
HOST=0.0.0.0
TRUST_PROXY=

# Local demo keys are separate from the Turso device keys.
DEMO_DATA_FILE=
DEMO_DEVICE_API_KEY=replace-with-a-random-local-preview-token
DEMO_SENDER_API_KEY=replace-with-a-separate-random-local-preview-token

# Turso/libSQL mode. Leave TURSO_DATABASE_URL empty to use the local simulation only.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Generate independent high-entropy values and keep them in a secret manager.
# 32 random bytes encoded as 64 hex chars or base64; encrypts SMTP/SMS and TOTP secrets at rest.
SETTINGS_ENCRYPTION_KEY=
# At least 32 random characters; HMAC key for one-time SMS verification/unsubscribe tokens.
SESSION_SECRET=
# One-time out-of-band token used only to create the first OWNER account (32+ random chars).
OWNER_BOOTSTRAP_TOKEN=
# Optional bootstrap-only CIDR list; defaults to ADMIN_CIDR_ALLOWLIST. Empty denies in production.
OWNER_BOOTSTRAP_CIDR_ALLOWLIST=
# Required in production for privileged Hackeradmin actions; comma-separated trusted source CIDRs.
ADMIN_CIDR_ALLOWLIST=
# Required in Turso mode for device telemetry; comma-separated sensor-gateway egress CIDRs.
DEVICE_CIDR_ALLOWLIST=
# Two different random values, each 32+ characters. Seed stores only their SHA-256 hashes.
FG_ESP32_API_KEY=
FG_ESP8266_API_KEY=

# Canonical public HTTPS origin used for email/SMS confirmation and unsubscribe links.
PUBLIC_APP_URL=

# Optional Web Push. Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:project-owner@example.org

# Inbox for the hourly rotating Hackeradmin operations code (delivered via the
# notification pipeline; only the code's hash is stored server-side).
OPS_SECURITY_EMAIL=

# Optional IPINFO.IO token for the advisory-only geolocation hint at registration.
# Never treated as a security boundary — the service-area allowlist is server-side.
IPINFO_TOKEN=

# Firmware download / GitHub links shown on /devices. Leave empty to hide the
# links and show an explicit "not configured" note. Never hard-code repo URLs.
VITE_FIRMWARE_ESP32_URL=
VITE_FIRMWARE_ESP8266_URL=
VITE_FIRMWARE_GITHUB_RELEASES_URL=
VITE_FIRMWARE_GITHUB_REPO_URL=

# SMS and SMTP credentials are entered through the protected Hackeradmin console.
