{
  "name": "floodguard",
  "version": "0.2.0",
  "private": true,
  "description": "FloodGuard — an educational smart flood-control and automation prototype.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"tsx watch server/index.ts\" \"vite --host 0.0.0.0 --port 5173 --strictPort\"",
    "build": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.json && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test server/**/*.test.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.19"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "cloudinary": "^2.7.0",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "web-push": "^3.6.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.11",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.5",
    "prisma": "6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
