{
  "name": "floodgrid",
  "version": "1.0.0",
  "private": true,
  "description": "FloodGrid \u2014 Smart Flood Control & Automation: an educational IoT flood-monitoring and automated barrier prototype platform.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"tsx watch server/index.ts\" \"vite --host 0.0.0.0 --port 5173 --strictPort\"",
    "build": "npm run icons && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.json && vite build",
    "start": "tsx server/index.ts",
    "preview": "npm run build && tsx server/index.ts",
    "test": "tsx --test server/**/*.test.ts",
    "test:watch": "tsx --test --watch server/**/*.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "node -e \"const fs=require('fs');for (const f of fs.readdirSync('data')) if (f.startsWith('floodgrid.db')) fs.rmSync('data/'+f);console.log('local database removed');\" && npm run db:migrate && npm run db:seed",
    "icons": "node scripts/generate-icons.mjs",
    "backup": "tsx scripts/backup.ts",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=20.19"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.7.0",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.48.0",
    "nodemailer": "^10.0.11",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "web-push": "^3.6.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.11",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
